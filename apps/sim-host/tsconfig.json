{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@boing-pets/contract": ["../../packages/contract/src/index.ts"],
      "@boing-pets/db": ["../../packages/db/src/index.ts"],
      "@boing-pets/sim": ["../../packages/sim/src/index.ts"]
    }
  },
  "include": ["src"]
}
