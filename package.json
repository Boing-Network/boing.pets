{
  "name": "boing-pets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 migrations apply pets --local",
    "build": "npm run typecheck && vite build && npm run build:function && npm run build:server",
    "build:function": "esbuild server/vercel-handler.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/[...path].js --packages=external",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run lint && npm run build && npm test",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:rpc": "node scripts/smoke-rpc.mjs",
    "format:check": "prettier --check .",
    "types:generate": "wrangler types worker/env.d.ts --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@boing-network/boing-sdk": "0.5.40",
    "@neondatabase/serverless": "^1.2.0",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.8.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
