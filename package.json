{
  "name": "boing-pets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 migrations apply pets --local",
    "build": "npm run typecheck \u0026\u0026 vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit \u0026\u0026 tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run lint \u0026\u0026 npm run build \u0026\u0026 npm test",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:rpc": "node scripts/smoke-rpc.mjs",
    "format:check": "prettier --check .",
    "types:generate": "wrangler types worker/env.d.ts --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@boing-network/boing-sdk": "0.5.40",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": "\u003e=22.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
