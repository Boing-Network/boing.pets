{
  "name": "boing-pets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contract",
    "packages/sim",
    "packages/db"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/contract/tsconfig.json --noEmit && tsc -p packages/sim/tsconfig.json --noEmit && tsc -p packages/db/tsconfig.json --noEmit",
    "lint": "eslint packages/contract packages/sim packages/db eslint.config.js --max-warnings 0",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "db:check": "node packages/db/scripts/check-sql.mjs",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
