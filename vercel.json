{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run client:build",
  "outputDirectory": "apps/client/dist",
  "redirects": [
    {
      "source": "/welcome",
      "destination": "/welcome/",
      "permanent": false
    },
    {
      "source": "/market",
      "destination": "/market/",
      "permanent": false
    }
  ]
}
