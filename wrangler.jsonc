{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boing-pets",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  // Shared preview: one workers.dev origin serves UI + /api (option A).
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "RPC_URL": "https://testnet-rpc.boing.network",
    // Must match the browser origin exactly (care POSTs are origin-gated).
    "APP_ORIGIN": "https://boing-pets.nico-chikuji.workers.dev",
    "MULTI_TOKEN_CONTRACT": "0x616c23d0c04015f72c3a3f63dcac1c734ce2151320a75a4fa99f318dd76b4451",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boing-pets",
      "database_id": "838d9755-4d84-41f5-af04-3aef48efa2a4",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAZA",
        "class_name": "PlazaRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-plaza",
      "new_sqlite_classes": ["PlazaRoom"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
